{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmitOnError": true,
    "outDir": "dist-server",
    "rootDir": ".",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "server/**/*.ts", "tests/**/*.ts", "vite.config.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "dist", "dist-server"]
}
